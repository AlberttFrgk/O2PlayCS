## ========================================================
## Standard .NET & Visual Studio / Rider / VS Code .gitignore
## ========================================================

# Build results
[Bb]in/
[Oo]bj/
[Aa]rtifacts/
out/

# Visual Studio temporary files, caches, and user settings
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.opendb
*.dbmdl

# JetBrains Rider & ReSharper
.idea/
*.DotSettings.user
_ReSharper*/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Local caches, test environments & NuGet
.dotnet_cli/
.dotnet_home/
packages/
*.nupkg
*.snupkg
project.lock.json

# Logs, crash dumps, and local test artifacts
*.log
crash.log
*.tmp
*.dmp
TestResults/
*.trx
*.coverage

# User runtime configuration
bin/**/settings.json
settings.json

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Explicitly ensure required native libraries are tracked
!bass.dll
!bass_fx.dll
!raylib.dll